# Copy to `.env.local` (already gitignored) to run KubePilot from source.
# Without this, `npm run dev`/`npm run build` produce a build that refuses
# to start — see `OFFICIAL_BUILD_KEY` in electron/main.ts and vite.config.ts.
# Ask the maintainer for the real value; it is intentionally not committed.
OFFICIAL_BUILD_KEY=

{
  "name": "kubepilot",
  "version": "2.0.3",
  "description": "KubePilot — a fast, modern desktop manager for multiple Kubernetes clusters",
  "author": {
    "name": "KubePilot",
    "email": "emersongaldino@hotmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "bump:version": "npm version patch --no-git-tag-version --no-commit-hooks",
    "package": "npm run bump:version && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "package:minor": "npm version minor --no-git-tag-version --no-commit-hooks && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "package:major": "npm version major --no-git-tag-version --no-commit-hooks && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fix-path": "^5.0.0",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.32.0",
    "monaco-editor": "^0.52.2",
    "monaco-yaml": "^5.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.11"
  }
}
